#!/usr/bin/env ruby
# A fake `secret-tool` (the Linux secret service) for the tests. Items come from the JSON in
# FAKE_SECRET_TOOL_STORE: {"locked": false, "items": [{"attributes": {"farmy": "farmy/GIT_TOKEN"}, "secret": "…"}]}.
# `lookup attr value [attr value …]` prints the secret of the item whose attributes hold every given
# pair, without a newline, as the real tool does; nothing there exits 1 silently; a locked collection
# exits 1 saying so on stderr, as does a secret service that cannot be reached ("unreachable": true, no
# D-Bus session on a headless host). `store --label=… attr value …` adds an item with the secret from stdin.
# Every call's arguments go to FAKE_SECRET_TOOL_LOG.
Encoding.default_external = Encoding::UTF_8 # whatever locale the caller has; the state files hold UTF-8
require "json"

store_path = ENV.fetch("FAKE_SECRET_TOOL_STORE") { abort "fake secret-tool: FAKE_SECRET_TOOL_STORE is not set" }
store = JSON.parse(File.read(store_path))
File.open(ENV["FAKE_SECRET_TOOL_LOG"], "a") { |f| f.puts ARGV.join(" ") } if ENV["FAKE_SECRET_TOOL_LOG"]

case ARGV[0]
when "lookup"
  if store["unreachable"]
    warn "secret-tool: Cannot autolaunch D-Bus without X11 $DISPLAY"
    exit 1
  end
  if store["locked"]
    warn "secret-tool: Cannot unlock the collection 'login': it is locked and no prompt is available"
    exit 1
  end
  wanted = ARGV.drop(1).each_slice(2).to_h
  item = store["items"].find { |i| wanted.all? { |k, v| i["attributes"][k] == v } }
  exit 1 unless item
  print item["secret"]
when "store"
  args = ARGV.drop(1).reject { |a| a.start_with?("--label") }
  store["items"] << { "attributes" => args.each_slice(2).to_h, "secret" => $stdin.read.to_s.chomp }
  File.write(store_path, JSON.generate(store))
else
  abort "fake secret-tool: cannot play: #{ARGV.join(" ")}"
end
