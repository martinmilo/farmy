  [ -z "$RUN_AS" ] || set -- ${SOCK_GID:+--group-add "$SOCK_GID"} -v farmy-home:/home/farmy "$@"
  [ -z "$RUN_LABEL" ] || set -- --label "farmy.user=$RUN_LABEL" "$@"
  docker_read run -d --name "$NAME" --init --restart unless-stopped --network farmy \
    -v "$SOCK:/var/run/docker.sock" -v "$FOLDER:$FOLDER" "$@" -w "$FOLDER" \
    -e DOCKER_CLI_HINTS=false -e FARMY_REGISTRY -e FARMY_SOURCE -e FARMY_BUILD ${TZV:+-e TZ="$TZV"} -v farmy-control:/root "$IMAGE" tail -f /dev/null
  if [ "$RC" = 0 ]; then MADE=1; C_RUNNING=true; C_NETWORKS=farmy; return 0; fi
  made_rc=$RC; made_err=$ERR_ALL
  case "$made_err" in
    *Conflict*)
      read_control
      if [ "$CTRL" = read ] && [ "$C_FOLDER" = "$FOLDER" ] && [ "${C_STATE:-$C_FOLDER}" = "$STATE" ] &&
        [ "$(uid_of "$C_USER")" = "$(uid_of "$RUN_LABEL")" ]; then
        EXEC_AS=$C_USER; case "$EXEC_AS" in 0|0:*) EXEC_AS= ;; esac
        return 0
      fi
      release_lock
      fail "another farmy made the control container while this one was making it, and it is not one for $(shown "$FOLDER") run as $(who "$RUN_AS"); run the command again" ;;
  esac
  release_lock
  [ -z "$made_err" ] || printf '%s\n' "$made_err" >&2
  exit "$made_rc"
}
# Made for a user, the control container gets, once, as root: that user's home in the farmy-home volume (exit
# 3 when it cannot), and what is root's in farmy's own folders handed to that user (record 2026-10-29-1800
# narrowed this), files an older farmy or an earlier sudo left root's: the default home's config folder and
# state folder, with all in them and the two folders themselves; .work of a project folder that belongs to
# that user. Never a project folder itself or what the user keeps there, and nothing in a folder another user
# owns: those paths are never handed to it. Only what is root's; a link is changed itself, never followed;
# never off the filesystem each starts on. Exit 1 when a change fails, with find's or chown's words.
HAND_BACK='u=$1; h=$2; shift 2
mkdir -p "$h" && chown "$u" "$h" && chmod 700 "$h" || exit 3
bad=0
for p in "$@"; do
  if [ -e "$p" ] || [ -L "$p" ]; then find "$p" -xdev -user 0 -exec chown -h "$u" {} + || bad=1; fi
done
exit $bad'
hand_back() {
  [ -n "$RUN_AS" ] || return 0
  set --
  if [ "$STATE" != "$FOLDER" ]; then set -- "$FOLDER" "$STATE"
  elif [ "$(owner_of "$FOLDER" || true)" = "$(uid_of "$RUN_AS")" ]; then set -- "$FOLDER/.work"
  fi
  docker_read exec -u 0 "$NAME" sh -c "$HAND_BACK" farmy-hand-back "$RUN_AS" "$(home_of "$RUN_AS")" "$@"
  case "$RC" in
    0) ;;
    3) echo "farmy: could not make farmy's home $(home_of "$RUN_AS") in the control container: ${ERR:-exit 3}" >&2 ;;
    *) echo "farmy: handing root's files in $(shown "$FOLDER") to $(who "$RUN_AS") failed: ${ERR:-exit $RC}" >&2 ;;
  esac
}
if [ -n "$APART" ]; then
  settle_run_as; settle_socket
  EXEC_AS=$RUN_AS
elif [ -z "$KEEP" ] && { [ "$CONTROL" = gone ] || [ -n "$OTHER" ] || [ -n "$WHY" ]; }; then
  settle_run_as; settle_socket
  [ -z "$STALE" ] || build_image
  docker rm -f "$NAME" >/dev/null 2>&1 || true
  make_control
  if [ -n "$MADE" ]; then EXEC_AS=$RUN_AS; hand_back; fi
fi
if [ -z "$APART" ]; then
  [ "$C_RUNNING" = true ] || docker start "$NAME" >/dev/null
  # a control container from an older farmy, on the default bridge: attached to farmy as well
  case " $C_NETWORKS " in *' farmy '*) ;; *) docker network connect farmy "$NAME" >/dev/null 2>&1 || true ;; esac
fi
release_lock

# What every docker exec of farmy carries, so that farmy inside reaches the same folder and state folder,
# each as -e NAME=value on the exec only (the shim's own environment, and so every command it runs here,
# stays as the user had it): the folder (its workdir and FARMY_DIR), XDG_CONFIG_HOME and XDG_STATE_HOME
# resolved here, this host's HOME as FARMY_HOST_HOME, the top folder of the Git repository the folder
# lies in as FARMY_HOST_GIT_TOP (the nearest .git, folder or file, at or above it, found by looking:
# inside the control container a parent's .git is not mounted), and the host's git identity, when the
# host has git and one, as GIT_USER_NAME / GIT_USER_EMAIL. The control container never sees the host's
# git configuration itself. On a Mac git runs only with the developer tools (xcode-select -p): without
# them /usr/bin/git is Apple's stub, which offers to install them each time it runs.
GIT_TOP=
dir=$FOLDER
while [ -n "$dir" ]; do
  if [ -e "$dir/.git" ]; then GIT_TOP=$dir; break; fi
  [ "$dir" != / ] || break
  dir=$(dirname "$dir")
done
HOST_GIT_NAME=; HOST_GIT_EMAIL=
if command -v git >/dev/null 2>&1 && { [ "$OS" != Darwin ] || xcode-select -p >/dev/null 2>&1; }; then
  HOST_GIT_NAME=$(git config --global user.name 2>/dev/null || true)
  HOST_GIT_EMAIL=$(git config --global user.email 2>/dev/null || true)
fi
# Run as the user (EXEC_AS, above), farmy gets a home of its own, in the farmy-home volume (made with the
# container), and its holder's socket in a folder of its own under /tmp: in the control container that user
# may have no account (Docker would give it HOME=/), and /run/farmy is root's. The user's tmux server is the
# one every command of that user shares.
EXEC_HOME=; HOLD_DIR=
[ -z "$EXEC_AS" ] || { EXEC_HOME=$(home_of "$EXEC_AS"); HOLD_DIR=/tmp/farmy-${EXEC_AS%%:*}; }
# A read-only command beside another folder's live runs (APART) runs in a container of its own: docker run
# --rm of the control container's image (as it names it, else by its ID), serving this folder as the
# control container would: this folder and its state folder at their paths, the socket, the same user and
# home, the farmy network. It has no holder: nothing that needs one is read-only.
APART_IMAGE=${C_IMAGE_NAME:-${C_IMAGE:-$IMAGE}}
[ -z "$APART" ] || HOLD_DIR=
in_farmy() { # in_farmy run|exec '<docker exec options>' <farmy's arguments…>: farmy in the control container
  how=$1; opts=$2; shift 2
  target=$NAME; [ -z "$APART" ] || target=$APART_IMAGE
  set -- ${EXEC_AS:+-u "$EXEC_AS"} ${EXEC_HOME:+-e "HOME=$EXEC_HOME"} ${HOLD_DIR:+-e "FARMY_HOLD_SOCKET=$HOLD_DIR/hold.sock"} \
    -e "FARMY_DIR=$FOLDER" ${CONFIG_HOME:+-e "XDG_CONFIG_HOME=$CONFIG_HOME"} \
    ${STATE_HOME:+-e "XDG_STATE_HOME=$STATE_HOME"} ${USER_HOME:+-e "FARMY_HOST_HOME=$USER_HOME"} \
    ${GIT_TOP:+-e "FARMY_HOST_GIT_TOP=$GIT_TOP"} ${HOST_GIT_NAME:+-e "GIT_USER_NAME=$HOST_GIT_NAME"} \
    ${HOST_GIT_EMAIL:+-e "GIT_USER_EMAIL=$HOST_GIT_EMAIL"} -w "$FOLDER" "$target" farmy "$@"
  if [ -n "$APART" ]; then
    [ "$STATE" = "$FOLDER" ] || set -- -v "$STATE:$STATE" "$@"
    if [ -n "$RUN_AS" ]; then set -- ${SOCK_GID:+--group-add "$SOCK_GID"} -v farmy-home:/home/farmy "$@"
    else set -- -v farmy-control:/root "$@"; fi
    set -- --rm --network farmy -v "$SOCK:/var/run/docker.sock" -v "$FOLDER:$FOLDER" \
      -e DOCKER_CLI_HINTS=false -e FARMY_REGISTRY -e FARMY_SOURCE -e FARMY_BUILD ${TZV:+-e TZ="$TZV"} "$@"
    [ "$how" != exec ] || exec docker run $opts "$@"
    docker run $opts "$@"
    return
  fi
  [ "$how" != exec ] || exec docker exec $opts "$@"
  docker exec $opts "$@"
}

TTY=""; [ -t 0 ] && [ -t 1 ] && TTY="-t"
if [ "$#" -eq 0 ]; then
  [ -n "$TTY" ] && in_farmy exec "-i $TTY" session
  in_farmy exec -i help
fi

# Unlocking values (farmy unlock-names: secrets.unlock, and without a provider every route's secret). farmy
# never stores a secret on disk: before a command that
# loads the brokers, the shim obtains each value from one source and pipes it to farmy, never on a command
# line. The source is the command in FARMY_UNLOCK_COMMAND (a shell line run here with the name as $1; a line
# without $1 gets the name appended) when it is set, else the macOS Keychain (security), else the Linux
# secret service (secret-tool), both under the one name <FARMY_SECRET_PREFIX><NAME>, default farmy/<NAME>.
# Only the names the control container does not hold yet are asked (farmy unlock-names --missing): it keeps
# what it was given until farmy lock or a restart of the container. A locked keychain is unlocked once
# (security unlock-keychain, on the terminal). What the source does not have is asked for here, hidden.
# FARMY_SECRET_PREFIX and FARMY_UNLOCK_COMMAND: the environment, else .env of the folder in use
from_env_file() {  # $1: the key; prints its value in .env (quotes taken off), nothing when absent
  [ -f "$FOLDER/.env" ] || return 0
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$FOLDER/.env" | tail -1 | sed 's/^"\(.*\)"$/\1/; s/^'"'"'\(.*\)'"'"'$/\1/'
}
if [ -z "${FARMY_SECRET_PREFIX+set}" ]; then
  FARMY_SECRET_PREFIX=$(from_env_file FARMY_SECRET_PREFIX)
  [ -n "$FARMY_SECRET_PREFIX" ] || unset FARMY_SECRET_PREFIX
fi
if [ -z "${FARMY_UNLOCK_COMMAND:-}" ]; then
  FARMY_UNLOCK_COMMAND=$(from_env_file FARMY_UNLOCK_COMMAND)
fi
PREFIX=${FARMY_SECRET_PREFIX-farmy/}
SOURCE="no store on the PATH and no FARMY_UNLOCK_COMMAND"
if [ -n "${FARMY_UNLOCK_COMMAND:-}" ]; then SOURCE="FARMY_UNLOCK_COMMAND"
elif command -v security >/dev/null 2>&1; then SOURCE="the Keychain"
elif command -v secret-tool >/dev/null 2>&1; then SOURCE="the secret service"
fi
from_command() {
  case "$FARMY_UNLOCK_COMMAND" in
    *'$1'*|*'${1}'*) sh -c "$FARMY_UNLOCK_COMMAND" farmy-unlock "$1" 2>/dev/null ;;
    *) sh -c "$FARMY_UNLOCK_COMMAND \"\$1\"" farmy-unlock "$1" 2>/dev/null ;;
  esac
}
keychain_lookup() { # the value; 36 while the keychain is locked, 1 when the item is not there
  out=$(security find-generic-password -s "$PREFIX$1" -w 2>/dev/null) && { printf '%s\n' "$out"; return 0; }
  [ $? -eq 36 ] && return 36
  return 1
}
KEYCHAIN_UNLOCKED=""
from_keychain() {
  keychain_lookup "$1" && return 0
  [ $? -eq 36 ] || return 1
  [ -n "$KEYCHAIN_UNLOCKED" ] && return 1
  KEYCHAIN_UNLOCKED=1
  echo "farmy: the keychain is locked; unlocking it once (security unlock-keychain)" >&2
  security unlock-keychain >&2 || true
  keychain_lookup "$1"
}
from_secret_service() {
  # a secret service that answers with an error (a locked collection, no D-Bus session on a headless host)
  # is named once and asked nothing more for this command; every value is then asked for instead
  [ -e "$SS_DOWN" ] && return 1
  out=$(secret-tool lookup farmy "$PREFIX$1" 2>"$SS_DOWN.err") && [ -n "$out" ] && { rm -f "$SS_DOWN.err"; printf '%s\n' "$out"; return 0; }
  msg=$(cat "$SS_DOWN.err" 2>/dev/null || true); rm -f "$SS_DOWN.err"
  if [ -n "$msg" ]; then
    echo "farmy: the secret service answers with an error, so it is not asked again; each value is asked for instead: $msg" >&2
    : > "$SS_DOWN"
    return 1
  fi
  return 1
}
unlock_value() {
  case "$SOURCE" in
    FARMY_UNLOCK_COMMAND) from_command "$1" ;;
    "the Keychain") from_keychain "$1" ;;
    "the secret service") from_secret_service "$1" ;;
    *) return 1 ;;
  esac
}
ask_hidden() { # on the terminal, never echoed
  printf '%s (for farmy; not shown): ' "$1" >/dev/tty
  stty -echo </dev/tty 2>/dev/null || true
  IFS= read -r out </dev/tty || out=""
  stty echo </dev/tty 2>/dev/null || true
  echo >/dev/tty
  printf '%s\n' "$out"
}
# the commands that load the brokers or run the provider, so take the unlocking values: start, restart,
# rebuild, keys reload, keys --why, factory start and answer. Every one goes through the lookup below; a
# command missing here would reach farmy with nothing on stdin and an empty holder, and farmy would prompt.
LOADS=""
case "${1:-}" in
  start|restart|rebuild) LOADS=1 ;;
  keys) case "${2:-}" in reload|--why) LOADS=1 ;; esac ;;
  factory) case "${2:-}" in start|answer) LOADS=1 ;; esac ;;
esac
UNLOCK=""
SS_DOWN="${TMPDIR:-/tmp}/farmy-secret-service-down.$$"   # a file: each lookup runs in a subshell
rm -f "$SS_DOWN"
if [ -n "$LOADS" ]; then
  for n in $(in_farmy run "" unlock-names --missing 2>/dev/null || true); do
    v=$(unlock_value "$n" || true)
    [ -n "$v" ] || [ -z "$TTY" ] || v=$(ask_hidden "$n")
    # base64, so that a multi-line value (an SSH key) arrives byte for byte
    if [ -n "$v" ]; then UNLOCK="${UNLOCK}${n}:base64=$(printf '%s' "$v" | base64 | tr -d '\n\r')
"
    else echo "farmy: $n: not found by $SOURCE and no terminal to ask on; the routes that need it stay locked" >&2
    fi
  done
fi
rm -f "$SS_DOWN"
# with the values on stdin docker exec cannot have -t: tell farmy that its output reaches a terminal
OUTTTY=""; [ -t 1 ] && OUTTTY="-e FARMY_TTY=1"
if [ -n "$UNLOCK" ]; then printf '%s' "$UNLOCK" | in_farmy run "-i $OUTTTY" "$@"
else in_farmy exec "-i $TTY" "$@"; fi
