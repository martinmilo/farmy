#!/bin/sh
# farmy — runs farmy in its control container. The host needs Docker and nothing else.
#
#   farmy                 attach to the persistent session (the TUI); without a terminal: the usage
#   farmy <command> …     any farmy command, in the folder in use: ~/.config/farmy, or the nearest folder
#                         up from here that holds a farmy.yml, or FARMY_DIR
#   farmy -C <dir> …      the same in that folder
#   farmy update          install the folder's pinned release, otherwise the newest published release
#
# The control container holds the Docker socket, the folder in use and its state folder (each at the
# same path, so the paths in the compose files hold for the daemon). The values farmy asks the host for
# (farmy unlock-names: those under
# farmy.yml's secrets.unlock, and without a provider every route's secret) come from one source on the
# host, never from a file: the command in
# FARMY_UNLOCK_COMMAND, the macOS Keychain or the Linux secret service (under <FARMY_SECRET_PREFIX><NAME>,
# default farmy/<NAME>), else a hidden prompt; they are piped to farmy, never on a command line.
set -eu
FARMY_SHIM_VERSION='@VERSION@'
FARMY_SHIM_COMMIT=''
FARMY_DEFAULT_REGISTRY=''
FARMY_DEFAULT_SOURCE=''
FARMY_DEFAULT_GITHUB=''
FARMY_DEFAULT_SOURCE_IS_GENERATED='1'
HERE=$(cd "$(dirname "$0")" && pwd)
SELF=$HERE/$(basename "$0")
# In a source checkout, these simple public build-time scalars come from the one release
# configuration. Release artifacts have their values embedded and need no adjacent files.
release_scalar() {
  awk -v key="$1" '
    $0 ~ ("^" key ":[[:space:]]*") {
      sub("^" key ":[[:space:]]*", ""); sub(/[[:space:]]+$/, "")
      if (($0 ~ /^\047/ && $0 ~ /\047$/) || ($0 ~ /^"/ && $0 ~ /"$/)) $0=substr($0,2,length($0)-2)
      print; exit
    }' "$2"
}
if [ -f "$HERE/release.yml" ]; then
  [ -n "$FARMY_DEFAULT_REGISTRY" ] || FARMY_DEFAULT_REGISTRY="ghcr.io/$(release_scalar owner "$HERE/release.yml")/farmy"
  [ -n "$FARMY_DEFAULT_GITHUB" ] || FARMY_DEFAULT_GITHUB=$(release_scalar github_url "$HERE/release.yml")
fi
FROM_CHECKOUT=
# A checkout reads VERSION; release artifacts embed it and need no neighboring files.
if [ "$FARMY_SHIM_VERSION" = '@VERSION@' ]; then
  FROM_CHECKOUT=1
  [ -f "$HERE/VERSION" ] || { echo 'farmy: missing embedded version or VERSION file' >&2; exit 1; }
  FARMY_SHIM_VERSION=$(cat "$HERE/VERSION")
fi
[ -n "$FARMY_DEFAULT_SOURCE" ] || [ -z "$FARMY_DEFAULT_GITHUB" ] || FARMY_DEFAULT_SOURCE="${FARMY_DEFAULT_GITHUB%.git}.git#v$FARMY_SHIM_VERSION:work"
FARMY_REGISTRY=${FARMY_REGISTRY:-$FARMY_DEFAULT_REGISTRY}
FARMY_SOURCE_IS_GENERATED=$FARMY_DEFAULT_SOURCE_IS_GENERATED
[ -z "${FARMY_SOURCE:-}" ] || FARMY_SOURCE_IS_GENERATED=0
FARMY_SOURCE=${FARMY_SOURCE:-$FARMY_DEFAULT_SOURCE}
FARMY_BUILD=${FARMY_BUILD-}
export FARMY_REGISTRY FARMY_SOURCE FARMY_BUILD DOCKER_CLI_HINTS=false
fail() { echo "farmy: $*" >&2; exit 1; }
# An exact version (record 2026-10-29-1800): MAJOR.MINOR.PATCH, or a pre-release MAJOR.MINOR.PATCH-rc.N.
valid_version() { printf '%s\n' "$1" | awk 'NR != 1 || $0 !~ /^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-rc\.[1-9][0-9]*)?$/ { bad = 1 } END { exit bad || NR != 1 }'; }
# Whether $1 comes before $2 as SemVer orders them: 0.2.0 < 0.3.0-rc.1 < 0.3.0-rc.2 < 0.3.0.
version_older() { awk -v a="$1" -v b="$2" '
  function cmp(x, y) { if (length(x) != length(y)) return length(x) < length(y) ? -1 : 1; return x == y ? 0 : (x < y ? -1 : 1) }
  BEGIN {
    pa = index(a, "-rc."); pb = index(b, "-rc.")
    split(pa ? substr(a, 1, pa - 1) : a, x, "."); split(pb ? substr(b, 1, pb - 1) : b, y, ".")
    for (i = 1; i <= 3; i++) { c = cmp(x[i] "", y[i] ""); if (c) exit c > 0 }
    if (!pa) exit 1
    if (!pb) exit 0
    exit cmp(substr(a, pa + 4) "", substr(b, pb + 4) "") >= 0
  }'; }
# The commit this farmy came from (record 2026-10-29-1800): installed, the one of the control image it came
# from (FARMY_SHIM_COMMIT, written by update and the installer); in a checkout, its HEAD, read from .git
# (git need not be installed); `commit unknown` when neither says. Seven hex digits, as the binary prints it.
checkout_commit() {
  d=$HERE
  while :; do
    if [ -d "$d/.git" ]; then g=$d/.git; break; fi
    if [ -f "$d/.git" ]; then
      g=$(sed -n 's/^gitdir: //p' "$d/.git"); case $g in /*) ;; *) g=$d/$g ;; esac; break
    fi
    [ "$d" != / ] || return 1
    d=$(dirname "$d")
  done
  common=$g
  if [ -f "$g/commondir" ]; then common=$(cat "$g/commondir"); case $common in /*) ;; *) common=$g/$common ;; esac; fi
  head=$(cat "$g/HEAD" 2>/dev/null) || return 1
  case $head in
    'ref: '*)
      ref=${head#ref: }
      if [ -f "$g/$ref" ]; then head=$(cat "$g/$ref")
      elif [ -f "$common/$ref" ]; then head=$(cat "$common/$ref")
      else head=$(awk -v r="$ref" '$2 == r { print $1; exit }' "$common/packed-refs" 2>/dev/null || true); fi ;;
  esac
  case $head in ''|*[!0-9a-f]*) return 1 ;; esac
  [ "${#head}" -ge 40 ] || return 1
  printf '%s\n' "$head" | cut -c1-7
}
shim_commit() {
  if [ -n "$FARMY_SHIM_COMMIT" ]; then printf '%s\n' "$FARMY_SHIM_COMMIT"
  elif [ -n "$FROM_CHECKOUT" ] && checkout_commit; then :
  else echo 'commit unknown'; fi
}
quote() { printf "'"; printf '%s' "$1" | sed "s/'/'\\\\''/g"; printf "'"; }
# One fingerprint for local control builds, release exports and the embedded binary identity.
# Only declared build inputs are visited; generated binaries and user workspaces are excluded.
inputs_hash() (
  cd "$HERE" || exit 1
  hash_tmp=$(mktemp -d "${TMPDIR:-/tmp}/farmy-inputs.XXXXXX") || exit 1
  trap 'rm -rf "$hash_tmp"' 0
  trap 'exit 1' HUP INT TERM
  : > "$hash_tmp/paths"
  : > "$hash_tmp/missing"
  for input in VERSION Dockerfile release.Dockerfile .dockerignore Dockerfile.dockerignore release.Dockerfile.dockerignore Cargo.toml Cargo.lock farmy README.md .env.example farmy.example.yml agents.yml tools.yml egress-hosts.yml factory-prompt.md keys.Dockerfile knowledge.Dockerfile gate.Dockerfile release.yml crates docs toolbox providers bin/build bin/release bin/render-release bin/install; do
    if [ -e "$input" ] || [ -L "$input" ]; then
      find "$input" -exec sh -c 'for input do
        case "$input" in *"
"*) echo "control build input contains a newline" >&2; exit 1 ;; esac
        printf "%s\n" "$input"
      done' sh {} + >> "$hash_tmp/paths" || exit 1
    else
      printf '%s\n' "$input" >> "$hash_tmp/paths"
      printf '%s\n' "$input" >> "$hash_tmp/missing"
    fi
  done
  LC_ALL=C sort -u "$hash_tmp/paths" > "$hash_tmp/sorted" || exit 1
  (
    while IFS= read -r file; do
      if [ -L "$file" ]; then
        printf 'link\000%s\000' "$file"
        readlink "$file" || exit 1
        printf '\000'
      elif [ -e "$file" ]; then
        mode=$(stat -c %a "$file" 2>/dev/null) || mode=$(stat -f %Lp "$file") || exit 1
        if [ -d "$file" ]; then printf 'dir\000%s\000%s\000' "$mode" "$file"
        elif [ -f "$file" ]; then
          printf 'file\000%s\000%s\000' "$mode" "$file"
          size=$(wc -c < "$file") || exit 1
          size=$((size + 0))
          printf '%s\000' "$size"
          cat "$file" || exit 1
          printf '\000'
        else echo "unsupported build input type: $file" >&2; exit 1; fi
      elif grep -qxF "$file" "$hash_tmp/missing"; then printf 'missing\000%s\000' "$file"
      else echo "control build input disappeared: $file" >&2; exit 1; fi
    done < "$hash_tmp/sorted"
  ) > "$hash_tmp/content" || exit 1
  if command -v sha256sum >/dev/null 2>&1; then sha256sum < "$hash_tmp/content" > "$hash_tmp/digest" || exit 1
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 < "$hash_tmp/content" > "$hash_tmp/digest" || exit 1
  elif command -v openssl >/dev/null 2>&1; then
    openssl dgst -sha256 < "$hash_tmp/content" > "$hash_tmp/raw" || exit 1
    sed 's/^.*= *//' "$hash_tmp/raw" > "$hash_tmp/digest" || exit 1
  else cksum < "$hash_tmp/content" > "$hash_tmp/digest" || exit 1; fi
  cut -d' ' -f1 "$hash_tmp/digest" || exit 1
)
if [ "${FARMY_HASH_ONLY:-}" = 1 ]; then inputs_hash || fail 'cannot fingerprint control build inputs'; exit 0; fi
valid_version "$FARMY_SHIM_VERSION" || fail 'invalid installed version; reinstall farmy'
# -C <dir> before the command: the folder to use. The shim consumes it; farmy gets the folder as FARMY_DIR.
HAVE_C=; DASH_C=
if [ "${1:-}" = -C ]; then
  [ "$#" -ge 2 ] || { echo 'farmy: -C needs a folder — farmy -C <dir> <command>' >&2; exit 2; }
  HAVE_C=1; DASH_C=${2:-.}; shift 2
fi
case "${1:-}" in --version|-V|version) printf 'farmy %s (%s)\n' "$FARMY_SHIM_VERSION" "$(shim_commit)"; exit 0 ;; esac

# The folder in use, resolved here on the host (the control container sees neither this folder's parents
# nor this HOME), first match: -C, FARMY_DIR, the nearest folder from here up that holds a farmy.yml, the
# default home: $XDG_CONFIG_HOME/farmy (else ~/.config/farmy), its state in $XDG_STATE_HOME/farmy (else
# ~/.local/state/farmy). The same paths on macOS: nothing goes under ~/Library. Every path is tidied (no
# trailing /, no //), so that the mounts match what Docker reports. The shim's own environment stays as the
# user had it: what farmy inside needs goes on its docker exec only.
tidy() { printf '%s\n' "$1" | sed -e 's://*:/:g' -e 's:\(.\)/$:\1:'; }
owner_of() { stat -c %u "$1" 2>/dev/null || stat -f %u "$1" 2>/dev/null; }
USER_HOME=
case "${HOME:-}" in /*) USER_HOME=$(tidy "$HOME") ;; esac
XDG_CONFIG=${XDG_CONFIG_HOME:-}; XDG_STATE=${XDG_STATE_HOME:-}
# Under sudo (record 2026-10-29-1800) the default home is never root's: a root caller whose SUDO_UID names
# another user acts for that user in it (SUDO_FOR: <uid>:<gid>). Its home is HOME, with XDG_*, when HOME is
# that user's (sudo -E, a Mac's sudo), else that user's home in the user database, without root's XDG_*; when
# neither, the default home is refused naming SUDO_USER. What the shim makes in that user's home (the default
# home's folders, missing parents included, and the lock) it makes as that user (MAKE_AS). A root login (no
# SUDO_UID) keeps root's own home.
SUDO_FOR=; MAKE_AS=
user_db_home() {
  for who in "${SUDO_USER:-}" "$SUDO_UID"; do
    [ -n "$who" ] || continue
    h=$(getent passwd "$who" 2>/dev/null | cut -d: -f6 || true)
    [ -n "$h" ] || h=$(dscl . -read "/Users/$who" NFSHomeDirectory 2>/dev/null | sed -n 's/^NFSHomeDirectory: *//p' || true)
    case "$h" in /*) tidy "$h"; return 0 ;; esac
  done
  return 1
}
if [ "$(id -u)" = 0 ]; then
  case "${SUDO_UID:-}" in ''|0|*[!0-9]*) ;; *)
    case "${SUDO_GID:-}" in ''|*[!0-9]*) ;; *)
      SUDO_FOR=$SUDO_UID:$SUDO_GID; MAKE_AS=$SUDO_FOR
      if [ -z "$USER_HOME" ] || [ "$(owner_of "$USER_HOME" || true)" != "$SUDO_UID" ]; then
        USER_HOME=$(user_db_home || true); XDG_CONFIG=; XDG_STATE=
      fi ;;
    esac ;;
  esac
fi
# make_folders <folder>…: each made with its missing parents, every one made handed to MAKE_AS
make_folders() {
  for d in "$@"; do
    made=; p=$d
    while [ ! -e "$p" ] && [ "$p" != / ] && [ "$p" != . ]; do made="$p
$made"; p=$(dirname "$p"); done
    mkdir -p "$d" || return 1
    if [ -n "$MAKE_AS" ] && [ -n "$made" ]; then
      old_ifs=$IFS; IFS='
'; set -f
      for m in $made; do chown "$MAKE_AS" "$m" || { IFS=$old_ifs; set +f; return 1; }; done
      IFS=$old_ifs; set +f
    fi
  done
}
shown() { # a path as messages write it: ~/… under the home
  case "$1" in
    "$USER_HOME") [ -n "$USER_HOME" ] && printf '~\n' || printf '%s\n' "$1" ;;
    "$USER_HOME"/*) [ -n "$USER_HOME" ] && [ "$USER_HOME" != / ] && printf '~/%s\n' "${1#"$USER_HOME"/}" || printf '%s\n' "$1" ;;
    *) printf '%s\n' "$1" ;;
  esac
}
xdg_dir() { # an absolute XDG value, else the fallback under HOME; nothing without either
  case "$1" in
    /*) tidy "$1" ;;
    *) [ -z "$USER_HOME" ] || tidy "$USER_HOME/$2" ;;
  esac
}
from_here() { case "$1" in /*) printf '%s\n' "$1" ;; *) printf '%s/%s\n' "$PWD" "$1" ;; esac; }
folder_at() { (CDPATH='' cd "$(from_here "$1")" 2>/dev/null && tidy "$(pwd)"); }
physical() { (CDPATH='' cd "$1" 2>/dev/null && pwd -P); }
CONFIG_HOME=$(xdg_dir "$XDG_CONFIG" .config)
STATE_HOME=$(xdg_dir "$XDG_STATE" .local/state)
HOME_CONFIG=${CONFIG_HOME:+$CONFIG_HOME/farmy}
HOME_STATE=${STATE_HOME:+$STATE_HOME/farmy}
no_home() {
  [ -z "$SUDO_FOR" ] || fail "under sudo the default home is ${SUDO_USER:-the user $SUDO_UID}'s, and neither HOME nor the user database names a home of theirs — use sudo -E, run farmy as ${SUDO_USER:-that user}, or name the folder with FARMY_DIR or -C <dir>; nothing was created"
  fail 'the default home needs HOME, which is not set or not an absolute path — set HOME (or XDG_CONFIG_HOME and XDG_STATE_HOME), or name the folder with FARMY_DIR or -C <dir>; nothing was created'
}
# help needs no folder: a -C or FARMY_DIR naming none does not stop it
LENIENT=
case "${1:-}" in help|-h|--help) LENIENT=1 ;; '') [ -t 0 ] && [ -t 1 ] || LENIENT=1 ;; esac
FOLDER=
if [ -n "$HAVE_C" ]; then
  if ! FOLDER=$(folder_at "$DASH_C"); then
    FOLDER=
    [ -n "$LENIENT" ] || { echo "farmy: -C $(shown "$(from_here "$DASH_C")"): no such folder — -C names a folder that exists; nothing was created" >&2; exit 2; }
  fi
elif [ -n "${FARMY_DIR:-}" ]; then
  if ! FOLDER=$(folder_at "$FARMY_DIR"); then
    FOLDER=
    [ -n "$LENIENT" ] || fail "FARMY_DIR names $(shown "$(from_here "$FARMY_DIR")"), which is no folder — make it, or unset FARMY_DIR to use $(if [ -n "$HOME_CONFIG" ]; then shown "$HOME_CONFIG"; else echo the default home; fi); nothing was created"
  fi
else
  dir=$(tidy "$PWD")
  while [ -n "$dir" ]; do
    if [ -f "$dir/farmy.yml" ]; then FOLDER=$dir; break; fi
    [ "$dir" != / ] || break
    dir=$(dirname "$dir")
  done
fi
# the default home's config folder is the default home however it is reached
IS_HOME=
if [ -z "$FOLDER" ] || { [ -n "$HOME_CONFIG" ] && [ "$FOLDER" = "$HOME_CONFIG" ]; }; then IS_HOME=1
elif [ -n "$HOME_CONFIG" ] && [ -d "$HOME_CONFIG" ] && [ "$(physical "$FOLDER")" = "$(physical "$HOME_CONFIG")" ]; then IS_HOME=1
fi
if [ -n "$IS_HOME" ]; then
  # refused before anything is made or Docker is asked when one of its paths needs a HOME there is not
  [ -n "$HOME_CONFIG" ] && [ -n "$HOME_STATE" ] || no_home
  FOLDER=$HOME_CONFIG; STATE=$HOME_STATE
  # a current folder that looks like a containers folder from before the default home: said, never written
  if [ -z "$LENIENT" ] && [ ! -f farmy.yml ] && [ "$(pwd -P)" != "$(physical "$FOLDER")" ]; then
    old=
    for definition in services/*.yml; do
      if [ -f "$definition" ]; then old=1; break; fi
    done
    if [ -z "$old" ] && [ -f .env ] && grep -q 'GIT_USER_NAME' .env 2>/dev/null; then old=1; fi
    if [ -n "$old" ]; then
      echo "farmy: using $(shown "$FOLDER"); this folder has no farmy.yml — to keep using it: touch farmy.yml (or farmy -C .)" >&2
    fi
  fi
  # made here, as this user (under sudo: as the user farmy acts for), before Docker would make a missing
  # bind source as root
  make_folders "$FOLDER" "$STATE" || fail "cannot make $(shown "$FOLDER") and $(shown "$STATE")"
else
  STATE=$FOLDER
fi
cd "$FOLDER" || fail "cannot enter $(shown "$FOLDER")"

# Read only ordinary top-level compatibility scalars. No evaluation and no host YAML dependency.
scalar() {
  [ -f "$2" ] || return 0
  awk -v key="$1" -v file="$2" '
  function bad() {print file ": invalid or ambiguous " key " scalar" > "/dev/stderr"; exit 1}
  /^[^[:space:]#]/ {
    line=$0
    if(line ~ ("^" key "[[:space:]]*:")) {
      if(++seen>1)bad()
      sub("^" key "[[:space:]]*:[[:space:]]*","",line)
      if(substr(line,1,1)=="\047" || substr(line,1,1)=="\"") {
        q=substr(line,1,1);line=substr(line,2);end=index(line,q);if(!end)bad()
        value=substr(line,1,end-1);tail=substr(line,end+1)
        if(tail !~ /^[[:space:]]*(#.*)?$/)bad()
      } else {sub(/[[:space:]]+#.*$/,"",line);sub(/[[:space:]]*$/,"",line);value=line}
      if(value=="" || value ~ /[[:space:]{}\[\]&*!|>]/)bad()
      result=value
    } else if(line ~ /^[{]/ || line ~ ("^[\047\"]" key "[\047\"]")) bad()
  }
  END {if(seen==1)print result}' "$2"
}
pin=$(scalar farmy farmy.yml) || exit 1
[ -z "$pin" ] || valid_version "$pin" || fail 'farmy.yml: farmy must pin an exact MAJOR.MINOR.PATCH version'
if [ "${1:-}" != update ] && [ -n "$pin" ] && [ "$pin" != "$FARMY_SHIM_VERSION" ]; then
  fail "farmy.yml pins $pin, but this shim is $FARMY_SHIM_VERSION: farmy update --to $pin"
fi
command -v docker >/dev/null 2>&1 || fail 'docker is not installed — it is the one thing farmy needs on this machine'
INFO=$(docker info 2>/dev/null) || fail "Docker isn't running — start it (OrbStack, Docker Desktop or colima), then try again"
# What the docker client says on stderr is never its answer (record 2026-10-29-1800): a client prints warnings
# there at every call (`WARNING: Error loading config file: …`) before an answer as good as without them.
# docker_read <docker arguments…>: OUT its stdout, RC its exit code, ERR the first line it said on stderr that
# is no warning (empty when there is none), ERR_ALL every such line.
docker_read() {
  errors=$(mktemp "${TMPDIR:-/tmp}/farmy-docker.XXXXXX" 2>/dev/null) || errors=
  if OUT=$(docker "$@" 2>"${errors:-/dev/null}"); then RC=0; else RC=$?; fi
  ERR=; ERR_ALL=
  if [ -n "$errors" ]; then
    ERR_ALL=$(grep -v -e "^WARNING" -e "^\$" "$errors" || true); rm -f "$errors"
    ERR=$(printf "%s\n" "$ERR_ALL" | head -n 1)
  fi
}
# Users as messages name them: <uid>:<gid>, and root for root (farmy run as root has no -u: an empty name).
who() { case "$1" in ''|0|0:*) echo root ;; *) echo "$1" ;; esac; }
uid_of() { case "$1" in '') echo 0 ;; *) echo "${1%%:*}" ;; esac; }

# The control container, read as a container (record 2026-10-29-1530: `docker inspect farmy` with no --type
# answers with whatever is named farmy, the farmy network once the container is removed by hand), in one
# read that names every field, the last line a mark that it answered in full (record 2026-10-29-1800). A
# read that fails or answers nothing is no reason to replace the container: the shim reads again, twice,
# and then refuses the command, keeping the container (CTRL=unreadable, CTRL_ERROR the daemon's words).
# CTRL=gone when Docker says there is no such container; CTRL=read with C_RUNNING (true or false), C_IMAGE
# (its image's ID), C_IMAGE_NAME, its labels C_FOLDER, C_STATE, C_USER (who farmy runs as there) and
# C_VERSION, C_NETWORKS, and C_BINDS (the folders it binds, one per line, for one an older farmy made).
CTRL_FIELDS='{{.State.Running}}
{{.Image}}
{{.Config.Image}}
{{index .Config.Labels "farmy.folder"}}
{{index .Config.Labels "farmy.state"}}
{{index .Config.Labels "farmy.user"}}
{{index .Config.Labels "farmy.version"}}
{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}
farmy-binds
{{range .Mounts}}{{if eq .Type "bind"}}{{.Destination}}
{{end}}{{end}}farmy-read'
CTRL=; CTRL_ERROR=; C_RUNNING=; C_IMAGE=; C_IMAGE_NAME=; C_FOLDER=; C_STATE=; C_USER=; C_VERSION=; C_NETWORKS=; C_BINDS=
read_control() {
  tries=0
  while :; do
    tries=$((tries + 1))
    docker_read container inspect -f "$CTRL_FIELDS" "$NAME"
    if [ "$RC" = 0 ]; then
      first=$(printf '%s\n' "$OUT" | sed -n 1p)
      if [ "$(printf '%s\n' "$OUT" | sed -n '$p')" = farmy-read ] && [ "$(printf '%s\n' "$OUT" | sed -n 9p)" = farmy-binds ] &&
        { [ "$first" = true ] || [ "$first" = false ]; }; then
        CTRL=read; break
      fi
      CTRL_ERROR=
    else
      case "$ERR" in *'No such container'*|*'No such object'*) CTRL=gone; return 0 ;; esac
      CTRL_ERROR=${ERR:-docker container inspect $NAME failed (exit $RC)}
    fi
    if [ "$tries" -ge 3 ]; then CTRL=unreadable; return 0; fi
    sleep 1
  done
  field() { v=$(printf '%s\n' "$OUT" | sed -n "$1p"); [ "$v" = '<no value>' ] || printf '%s\n' "$v"; }
  C_RUNNING=$(field 1); C_IMAGE=$(field 2); C_IMAGE_NAME=$(field 3)
  C_FOLDER=$(field 4); C_STATE=$(field 5); C_USER=$(field 6); C_VERSION=$(field 7); C_NETWORKS=$(field 8)
  C_BINDS=$(printf '%s\n' "$OUT" | sed -e '1,9d' -e '$d' | grep -v -e '^/var/run/docker.sock$' -e '^$' || true)
}
refuse_unreadable() {
  release_lock
  if [ -n "$CTRL_ERROR" ]; then
    fail "the control container $NAME could not be read (docker container inspect $NAME: $CTRL_ERROR); it is kept, and this command is not run — try again once Docker answers"
  fi
  fail "the control container $NAME could not be read (docker container inspect $NAME answered nothing); it is kept, and this command is not run — try again once Docker answers"
}

# One maker at a time (record 2026-10-29-1800): a lock file in the state home, taken around reading the
# control container and making or reusing it, released before the command runs. A second shim that finds
# it taken waits (saying so once), then reads the container the first made and reuses it. A lock whose
# holder is gone (a shim killed while it made the container) holds no one up. It is made as the user the
# shim acts for (MAKE_AS under sudo); without a state home there is no lock.
LOCK=
alive() { kill -0 "$1" 2>/dev/null || [ -d "/proc/$1" ] || ps -p "$1" >/dev/null 2>&1; }
take_lock() {
  [ -n "$HOME_STATE" ] || return 0
  make_folders "$HOME_STATE" 2>/dev/null || return 0
  lock=$HOME_STATE/control.lock; waiting=; empty=0; tries=0
  while ! ( set -C; printf "%s\n" "$$" > "$lock" ) 2>/dev/null; do
    if [ ! -f "$lock" ]; then
      # gone meanwhile: again; one that cannot be made at all (the state home not writable): no lock
      tries=$((tries + 1)); [ "$tries" -le 3 ] || return 0
      continue
    fi
