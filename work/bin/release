#!/bin/sh
# Publish a registry-selected release, or export one image as a multi-platform OCI archive.
set -eu
cd "$(dirname "$0")/.."
fail() { echo "farmy release: $*" >&2; exit 1; }
# An exact version: MAJOR.MINOR.PATCH, or a pre-release MAJOR.MINOR.PATCH-rc.N.
valid_version() { printf '%s\n' "$1" | awk 'NR != 1 || $0 !~ /^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-rc\.[1-9][0-9]*)?$/ { bad = 1 } END { exit bad || NR != 1 }'; }
[ "$#" -gt 0 ] || fail 'usage: bin/release VERSION [--image ROLE --output ARCHIVE]'
version=$1; shift
valid_version "$version" || fail 'VERSION must be exact MAJOR.MINOR.PATCH or MAJOR.MINOR.PATCH-rc.N'
[ "$version" = "$(cat VERSION)" ] || fail "requested version differs from repository VERSION ($(cat VERSION))"
role=; archive=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --image) [ "$#" -ge 2 ] || fail '--image needs a role'; role=$2; shift 2 ;;
    --output) [ "$#" -ge 2 ] || fail '--output needs an archive'; archive=$2; shift 2 ;;
    *) fail "unknown argument $1" ;;
  esac
done
case "$role" in ''|control|keys|knowledge|gate) ;; *) fail "unknown image role $role" ;; esac
if [ -n "$archive" ]; then
  [ -n "$role" ] || fail '--output needs --image ROLE'
  case "$archive" in *,*) fail 'archive paths cannot contain commas' ;; esac
elif [ -n "$role" ]; then fail '--image needs --output ARCHIVE'
else
  if [ -z "${FARMY_REGISTRY:-}" ]; then
    owner=$(awk '/^owner:/{sub(/^owner:[[:space:]]*/, "");gsub(/[\047"]/, "");print;exit}' release.yml)
    [ -n "$owner" ] || fail 'release.yml must name the public owner'
    FARMY_REGISTRY="ghcr.io/$owner/farmy"
  fi
fi
hash=$(FARMY_HASH_ONLY=1 sh ./farmy) || fail 'cannot fingerprint build inputs'
# the commit the images are built from: farmy.commit, and what the binary inside prints with its version
commit=$(git rev-parse HEAD 2>/dev/null | cut -c1-7 || true)
case "$commit" in *[!0-9a-f]*|'') commit= ;; esac
for image in ${role:-control keys knowledge gate}; do
  set -- buildx build --platform linux/amd64,linux/arm64 --file release.Dockerfile --target "$image" \
    --build-arg "FARMY_VERSION=$version" --build-arg "FARMY_HASH=$hash" \
    --label "farmy.version=$version" --label "farmy.hash=$hash"
  [ -z "$commit" ] || set -- "$@" --build-arg "FARMY_COMMIT=$commit" --label "farmy.commit=$commit"
  [ "$image" != control ] || set -- "$@" --label farmy.format=1
  if [ -n "$archive" ]; then set -- "$@" --output "type=oci,dest=$archive"
  else
    registry=${FARMY_REGISTRY%/}
    set -- "$@" --tag "$registry/farmy-$image:$version"
    # a pre-release never moves latest: it is tagged next, where farmy update from a pre-release looks
    case "$version" in
      *-*) set -- "$@" --tag "$registry/farmy-$image:next" ;;
      *) set -- "$@" --tag "$registry/farmy-$image:latest" ;;
    esac
    set -- "$@" --push
  fi
  docker "$@" . || fail "build/export failed for $image"
done
if [ -n "$archive" ]; then echo "exported farmy $role $version to $archive"
else echo "published farmy $version to $registry"; fi
