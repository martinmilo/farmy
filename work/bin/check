#!/bin/sh
# sanity/rust rust-v0.1.0
# The whole check: formatting, lints, dependency policy, tests. Exit 0 means the tree is
# clean. CI runs this script and nothing else of its own except the jobs that need extra
# tools or toolchains; see ci.yml.
set -eu
cd "$(dirname "$0")/.."

if ! cargo deny --version >/dev/null 2>&1; then
    echo "bin/check needs cargo-deny and it is not installed." >&2
    echo "Install it with: cargo install --locked cargo-deny" >&2
    exit 2
fi

run() {
    echo "==> $*"
    "$@"
}

run cargo fmt --all --check
run cargo clippy --workspace --all-targets --locked -- -D warnings
run cargo deny --workspace check
run cargo test --workspace --locked
echo "==> clean"
