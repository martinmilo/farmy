# farmy's settings for this machine. `farmy init` writes this file into the containers folder and fills
# the Git identity from this host's git config. No secret lives here: secrets come from the provider
# named in farmy.yml (see farmy.example.yml). Where repositories live is in each services/<name>.yml
# (repo: the clone URL) and in farmy.yml (keys: a git route per host).

# Git identity inside the containers (commits made there carry it).
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# The name other machines reach this host by (an IP or a name): `farmy url` / `status` and every ${url:…}
# in a definition then use it instead of localhost.
# LAN_HOST=
